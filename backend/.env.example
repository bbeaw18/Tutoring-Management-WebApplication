PORT=5000
# Tuition claims require a replica set or sharded MongoDB deployment.
MONGODB_URI=mongodb://localhost:27017/kms_db
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:4200
MAX_FILE_SIZE=52428800
UPLOAD_DIR=uploads

# SMTP (สำหรับส่งอีเมล reset password และการแจ้งเตือนต่าง ๆ)
# ถ้าไม่ตั้ง — ระบบจะ skip การส่งอีเมลโดยอัตโนมัติ
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

PROMPTPAY_ID=
KBANK_WEBHOOK_SECRET=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# LINE MINI App and Messaging API channels must belong to the same Provider.
LINE_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_TUITION_URL=
LINE_REMINDERS_ENABLED=false
